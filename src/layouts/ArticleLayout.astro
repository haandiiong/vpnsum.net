---
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	description?: string;
	createTime?: string | Date;
	updateTime?: string | Date;
	tags?: string[];
	noindex?: boolean;
	cover?: string;
	relatedArticles?: {
		title: string;
		description?: string;
		permalink: string;
	}[];
	headings?: {
		depth: number;
		slug: string;
		text: string;
	}[];
	faq?: {
		question: string;
		answer: string;
	}[];
	itemList?: {
		name: string;
		url: string;
	}[];
}

const {
	title,
	description,
	createTime,
	updateTime,
	tags = [],
	noindex = false,
	cover = '/site-og.jpg',
	relatedArticles = [],
	headings = [],
	faq = [],
	itemList = [],
} = Astro.props;

const displayDate = (value?: string | Date) => {
	if (!value) return '';
	const normalized = value instanceof Date ? value.toISOString().slice(0, 10) : String(value).slice(0, 10);
	return normalized.replaceAll('/', '.').replaceAll('-', '.');
};

const isoDate = (value?: string | Date) => {
	if (!value) return undefined;
	const normalized = value instanceof Date ? value : new Date(String(value).replaceAll('/', '-'));
	return Number.isNaN(normalized.getTime()) ? undefined : normalized.toISOString();
};

const siteUrl = 'https://www.vpnsum.net';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const pathSection = Astro.url.pathname.split('/').filter(Boolean)[0] ?? '';
const sectionMap: Record<string, { name: string; url: string }> = {
	posts: { name: '文章目录', url: '/posts/' },
	guides: { name: '使用指南', url: '/guides/' },
	airports: { name: '机场介绍', url: '/airports/' },
	global: { name: '全球信息', url: '/posts/' },
	search: { name: '搜索技巧', url: '/posts/' },
	tools: { name: '工具资源', url: '/posts/' },
};
const section = sectionMap[pathSection];
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const publishedTime = isoDate(createTime);
const modifiedTime = isoDate(updateTime) ?? publishedTime;
const articleJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	'@id': `${canonicalUrl}#article`,
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': canonicalUrl,
	},
	headline: title,
	description,
	image: [new URL(cover, siteUrl).toString()],
	...(publishedTime ? { datePublished: publishedTime } : {}),
	...(modifiedTime ? { dateModified: modifiedTime } : {}),
	inLanguage: 'zh-CN',
	keywords: tags.join(', '),
	author: {
		'@type': 'Organization',
		name: 'vpnsum.net 编辑团队',
		url: `${siteUrl}/about/`,
	},
	publisher: { '@id': `${siteUrl}/#organization` },
	isPartOf: { '@id': `${siteUrl}/#website` },
};
const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: '首页', item: `${siteUrl}/` },
		...(section ? [{ '@type': 'ListItem', position: 2, name: section.name, item: new URL(section.url, siteUrl).toString() }] : []),
		{ '@type': 'ListItem', position: section ? 3 : 2, name: title, item: canonicalUrl },
	],
};
const faqJsonLd = faq.length > 0 ? {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((entry) => ({
		'@type': 'Question',
		name: entry.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: entry.answer,
		},
	})),
} : undefined;
const itemListJsonLd = itemList.length > 0 ? {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	numberOfItems: itemList.length,
	itemListElement: itemList.map((entry, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: entry.name,
		url: new URL(entry.url, siteUrl).toString(),
	})),
} : undefined;
const structuredData = [articleJsonLd, breadcrumbJsonLd, faqJsonLd, itemListJsonLd]
	.filter((entry): entry is Record<string, unknown> => Boolean(entry));
---

<BaseLayout
	title={title}
	description={description}
	noindex={noindex}
	type="article"
	image={cover}
	publishedTime={publishedTime}
	modifiedTime={modifiedTime}
	tags={tags}
	jsonLd={structuredData}
>
		<main>
			<header class="article-hero">
				<div class="article-hero-inner">
					<nav class="breadcrumbs" aria-label="面包屑">
						<a href="/">首页</a>
						<span aria-hidden="true">/</span>
						{section && <a href={section.url}>{section.name}</a>}
						{section && <span aria-hidden="true">/</span>}
						<span aria-current="page">{title}</span>
					</nav>
					<h1>{title}</h1>
					{description && <p class="article-description">{description}</p>}
					<div class="article-meta">
						<span>作者：<a href="/about/">vpnsum.net 编辑团队</a></span>
						{createTime && <span>发布于 {displayDate(createTime)}</span>}
						{updateTime && <span>更新于 {displayDate(updateTime)}</span>}
						{tags.slice(0, 4).map((tag) => <span class="tag">#{tag}</span>)}
					</div>
			</div>
		</header>
				<div class="article-shell">
					<div class="article-main">
						<article class="article-content">
							<slot />
						</article>
						{relatedArticles.length > 0 && (
							<section class="related-section" aria-labelledby="related-heading">
								<p class="related-kicker">继续阅读</p>
								<h2 id="related-heading">与你当前主题相关</h2>
								<div class="related-grid">
									{relatedArticles.map((article) => (
										<a href={article.permalink}>
											<strong>{article.title}</strong>
											{article.description && <span>{article.description}</span>}
											<em>查看文章 →</em>
										</a>
									))}
								</div>
							</section>
						)}
					</div>
				<aside class="article-aside">
					<p class="aside-label">阅读提示</p>
					<p>服务价格、功能和可用性会持续变化。购买或订阅前，请查看官方信息并先做短周期测试。</p>
					{tocHeadings.length >= 4 && (
						<nav class="article-toc" aria-label="文章目录">
							<p class="aside-label">文章目录</p>
							{tocHeadings.map((heading) => (
								<a class:list={{ 'toc-subitem': heading.depth === 3 }} href={`#${heading.slug}`}>{heading.text}</a>
							))}
						</nav>
					)}
					<a href="/risk-monitor/">查看风险监测 →</a>
					<a href="/posts/jichang-test-disclosure/">了解评测方法 →</a>
					</aside>
			</div>
		</main>
		<dialog class="image-lightbox" aria-label="图片大图预览">
			<button class="lightbox-close" type="button" aria-label="关闭大图预览">×</button>
			<img class="lightbox-image" src="" alt="" />
			<p class="lightbox-caption"></p>
		</dialog>
	</BaseLayout>

<style>
	.article-hero {
		padding: 72px clamp(22px, 7vw, 100px) 62px;
		background:
			radial-gradient(circle at 86% 20%, rgba(70, 217, 197, 0.18), transparent 26%),
			#0a1d39;
		color: white;
	}

	.article-hero-inner {
		max-width: 980px;
		margin: 0 auto;
	}

		.breadcrumbs {
			display: flex;
			align-items: center;
			gap: 8px;
			margin-bottom: 26px;
			color: rgba(255, 255, 255, 0.48);
			font-size: 13px;
			white-space: nowrap;
			overflow: hidden;
		}

		.breadcrumbs a {
			color: #74e7d5;
			font-weight: 700;
			text-decoration: none;
		}

		.breadcrumbs span:last-child {
			overflow: hidden;
			text-overflow: ellipsis;
		}

	h1 {
		max-width: 900px;
		margin: 0;
		font-size: clamp(38px, 5.6vw, 70px);
		line-height: 1.13;
		letter-spacing: -0.045em;
	}

	.article-description {
		max-width: 820px;
		margin: 22px 0 0;
		color: rgba(255, 255, 255, 0.68);
		font-size: 17px;
		line-height: 1.8;
	}

		.article-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px;
		margin-top: 28px;
		color: rgba(255, 255, 255, 0.5);
			font-size: 12px;
		}

		.article-meta a {
			color: rgba(255, 255, 255, 0.8);
			text-underline-offset: 3px;
		}

	.tag {
		padding: 5px 9px;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 999px;
		color: rgba(255, 255, 255, 0.7);
	}

	.article-shell {
		display: grid;
		grid-template-columns: minmax(0, 760px) 230px;
		justify-content: center;
		align-items: start;
		gap: 70px;
		padding: 72px clamp(22px, 5vw, 72px) 110px;
		background: #fff;
	}

		.article-main,
		.article-content {
			min-width: 0;
		}

	.article-content :global(h2) {
		margin: 2.2em 0 0.8em;
		padding-top: 0.5em;
		font-size: clamp(25px, 3vw, 34px);
		line-height: 1.28;
		letter-spacing: -0.025em;
		color: #07152b;
		border-top: 1px solid #dce4ee;
	}

	.article-content :global(h3) {
		margin: 1.9em 0 0.7em;
		font-size: 22px;
		line-height: 1.4;
		color: #102a4c;
	}

	.article-content :global(p),
	.article-content :global(li) {
		font-size: 16px;
		line-height: 1.9;
		color: #344054;
	}

	.article-content :global(a) {
		color: #155eef;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	.article-content :global(strong) {
		color: #101828;
	}

	.article-content :global(blockquote) {
		margin: 28px 0;
		padding: 18px 22px;
		border-left: 4px solid #46d9c5;
		background: #effbf8;
	}

	.article-content :global(blockquote p) {
		margin: 0;
	}

	.article-content :global(table) {
		display: table;
		width: 100%;
		margin: 34px 0;
		border-spacing: 0;
		border: 1px solid #d8e2ed;
		border-radius: 14px;
		background: #fff;
		box-shadow:
			0 1px 2px rgba(7, 21, 43, 0.04),
			0 14px 36px rgba(7, 21, 43, 0.07);
		overflow-x: auto;
		scrollbar-width: thin;
		scrollbar-color: #aab9ca #edf2f7;
	}

	.article-content :global(th),
	.article-content :global(td) {
		min-width: 138px;
		padding: 15px 17px;
		border-right: 1px solid #e4ebf3;
		border-bottom: 1px solid #e4ebf3;
		text-align: left;
		font-size: 14px;
		line-height: 1.6;
		vertical-align: top;
	}

	.article-content :global(th) {
		background: linear-gradient(135deg, #0b2547, #123a65);
		color: #fff;
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 0.035em;
		white-space: nowrap;
	}

	.article-content :global(th:first-child) {
		border-top-left-radius: 13px;
	}

	.article-content :global(th:last-child) {
		border-top-right-radius: 13px;
	}

	.article-content :global(th:last-child),
	.article-content :global(td:last-child) {
		border-right: 0;
	}

	.article-content :global(tbody tr:nth-child(even) td) {
		background: #f7f9fc;
	}

	.article-content :global(tbody tr:hover td) {
		background: #edf9f7;
	}

	.article-content :global(tbody tr:hover td:first-child) {
		box-shadow: inset 3px 0 #46d9c5;
	}

	.article-content :global(tbody tr:last-child td) {
		border-bottom: 0;
	}

	.article-content :global(td:first-child) {
		color: #102a4c;
		font-weight: 700;
	}

	.article-content :global(table a) {
		display: inline-flex;
		align-items: center;
		padding: 4px 9px;
		border-radius: 999px;
		background: rgba(21, 94, 239, 0.09);
		color: #155eef;
		font-size: 13px;
		font-weight: 750;
		line-height: 1.45;
		text-decoration: none;
		white-space: nowrap;
	}

	.article-content :global(table a:hover) {
		background: #155eef;
		color: #fff;
	}

	.article-content :global(.airport-overview-table) {
		width: min(900px, calc(100vw - 48px));
		margin: 34px 50% 42px;
		transform: translateX(-50%);
		overflow-x: auto;
		border: 1px solid #d8e2ed;
		border-radius: 14px;
		background: #fff;
		box-shadow:
			0 1px 2px rgba(7, 21, 43, 0.04),
			0 14px 36px rgba(7, 21, 43, 0.07);
		scrollbar-width: thin;
		scrollbar-color: #aab9ca #edf2f7;
	}

	.article-content :global(.airport-overview-table table) {
		width: 100%;
		min-width: 860px;
		margin: 0;
		border: 0;
		border-radius: 0;
		box-shadow: none;
	}

	.article-content :global(.airport-overview-table th),
	.article-content :global(.airport-overview-table td) {
		min-width: 0;
		padding: 10px 9px;
		font-size: 12px;
		line-height: 1.45;
	}

	.article-content :global(.airport-overview-table th) {
		font-size: 11px;
		white-space: normal;
	}

	.article-content :global(.airport-overview-table td:nth-child(1)) {
		min-width: 88px;
	}

	.article-content :global(.airport-overview-table td:nth-child(2)) {
		min-width: 84px;
	}

	.article-content :global(.airport-overview-table table a) {
		padding: 4px 7px;
		font-size: 12px;
		white-space: normal;
	}

	.article-content :global(.official-link) {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 10px 16px;
		border: 1px solid #155eef;
		border-radius: 9px;
		background: #155eef;
		box-shadow: 0 8px 20px rgba(21, 94, 239, 0.18);
		color: #fff;
		font-size: 14px;
		font-weight: 800;
		line-height: 1.2;
		text-decoration: none;
		white-space: nowrap;
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}

	.article-content :global(.official-link::after) {
		content: '↗';
		font-size: 12px;
	}

	.article-content :global(.official-link:hover) {
		border-color: #0b4ed4;
		background: #0b4ed4;
		box-shadow: 0 10px 24px rgba(21, 94, 239, 0.26);
		color: #fff;
		transform: translateY(-1px);
	}

	.article-content :global(.official-link:focus-visible) {
		outline: 3px solid rgba(70, 217, 197, 0.7);
		outline-offset: 3px;
	}

	.article-content :global(:not(pre) > code) {
		padding: 0.18em 0.42em;
		border-radius: 5px;
		background: #edf2f7;
		color: #102a4c;
		font-size: 0.88em;
	}

	.article-content :global(pre) {
		margin: 24px 0;
		padding: 20px 22px;
		border: 1px solid #263b55;
		border-radius: 12px;
		background: #0b1728 !important;
		box-shadow: 0 12px 30px rgba(7, 21, 43, 0.14);
		color: #f1f5f9 !important;
		overflow-x: auto;
	}

	.article-content :global(pre code) {
		display: block;
		min-width: max-content;
		padding: 0;
		border-radius: 0;
		background: transparent;
		color: inherit;
		font-size: 14px;
		line-height: 1.75;
	}

	.article-content :global(img) {
		display: inline-block;
		width: min(100%, 260px);
		height: 180px;
		margin: 10px 8px 10px 0;
		padding: 7px;
		border: 1px solid #dce4ee;
		border-radius: 12px;
		background: #f7f9fc;
		box-shadow: 0 8px 22px rgba(7, 21, 43, 0.08);
		object-fit: contain;
		vertical-align: middle;
		cursor: zoom-in;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}

	.article-content :global(img:hover) {
		border-color: #9eb4ce;
		box-shadow: 0 12px 28px rgba(7, 21, 43, 0.13);
		transform: translateY(-2px);
	}

	.article-content :global(img:focus-visible) {
		outline: 3px solid rgba(21, 94, 239, 0.45);
		outline-offset: 3px;
	}

	.image-lightbox {
		width: 100vw;
		max-width: none;
		height: 100vh;
		max-height: none;
		margin: 0;
		padding: 54px 24px 28px;
		border: 0;
		background: rgba(3, 12, 28, 0.94);
		color: #fff;
	}

	.image-lightbox[open] {
		display: grid;
		grid-template-rows: minmax(0, 1fr) auto;
		place-items: center;
		gap: 14px;
	}

	.image-lightbox::backdrop {
		background: rgba(3, 12, 28, 0.84);
		backdrop-filter: blur(8px);
	}

	.lightbox-image {
		max-width: min(94vw, 1400px);
		max-height: calc(100vh - 120px);
		border-radius: 12px;
		box-shadow: 0 26px 80px rgba(0, 0, 0, 0.48);
		object-fit: contain;
	}

	.lightbox-caption {
		max-width: min(90vw, 900px);
		margin: 0;
		color: rgba(255, 255, 255, 0.72);
		font-size: 13px;
		line-height: 1.5;
		text-align: center;
	}

	.lightbox-close {
		position: fixed;
		top: 16px;
		right: 18px;
		display: grid;
		place-items: center;
		width: 42px;
		height: 42px;
		padding: 0;
		border: 1px solid rgba(255, 255, 255, 0.28);
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.12);
		color: #fff;
		font: inherit;
		font-size: 28px;
		line-height: 1;
		cursor: pointer;
	}

	.lightbox-close:hover {
		background: rgba(255, 255, 255, 0.22);
	}

	.lightbox-close:focus-visible {
		outline: 3px solid #46d9c5;
		outline-offset: 3px;
	}

	.article-aside {
		position: sticky;
		top: 110px;
		padding: 22px;
		border: 1px solid #dce4ee;
		border-radius: 14px;
		background: #f7f9fc;
	}

	.aside-label {
		margin: 0 0 10px !important;
		color: #07152b !important;
		font-weight: 800;
	}

	.article-aside p {
		margin: 0 0 16px;
		color: #667085;
		font-size: 13px;
		line-height: 1.7;
	}

		.article-aside a {
			display: block;
			margin-top: 10px;
			color: #155eef;
			font-size: 13px;
			font-weight: 700;
			text-decoration: none;
		}

		.article-toc {
			max-height: min(52vh, 430px);
			margin: 20px 0;
			padding: 18px 0;
			border-top: 1px solid #dce4ee;
			border-bottom: 1px solid #dce4ee;
			overflow-y: auto;
			scrollbar-width: thin;
		}

		.article-toc .aside-label {
			margin-bottom: 12px !important;
		}

		.article-toc a {
			margin-top: 0;
			padding: 5px 0;
			color: #475467;
			font-size: 12px;
			font-weight: 650;
			line-height: 1.45;
		}

		.article-toc a:hover {
			color: #155eef;
		}

		.article-toc .toc-subitem {
			padding-left: 12px;
			color: #667085;
			font-weight: 550;
		}

		.related-section {
			margin-top: 64px;
			padding-top: 36px;
			border-top: 1px solid #dce4ee;
		}

		.related-kicker {
			margin: 0 0 8px;
			color: #155eef;
			font-size: 12px;
			font-weight: 800;
			letter-spacing: 0.12em;
			text-transform: uppercase;
		}

		.related-section h2 {
			margin: 0 0 22px;
			color: #07152b;
			font-size: clamp(25px, 3vw, 32px);
		}

		.related-grid {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 14px;
		}

		.related-grid a {
			display: flex;
			flex-direction: column;
			min-height: 190px;
			padding: 20px;
			border: 1px solid #dce4ee;
			border-radius: 14px;
			background: #f7f9fc;
			color: #07152b;
			text-decoration: none;
			transition: border-color 0.2s ease, transform 0.2s ease;
		}

		.related-grid a:hover {
			border-color: #9eb4ce;
			transform: translateY(-2px);
		}

		.related-grid strong {
			font-size: 16px;
			line-height: 1.5;
		}

		.related-grid span {
			display: -webkit-box;
			margin-top: 10px;
			color: #667085;
			font-size: 13px;
			line-height: 1.65;
			-webkit-box-orient: vertical;
			-webkit-line-clamp: 3;
			overflow: hidden;
		}

		.related-grid em {
			margin-top: auto;
			padding-top: 16px;
			color: #155eef;
			font-size: 12px;
			font-style: normal;
			font-weight: 800;
		}

	@media (max-width: 900px) {
		.article-shell {
			grid-template-columns: minmax(0, 760px);
		}

			.article-aside {
				position: static;
				order: -1;
			}

			.related-grid {
				grid-template-columns: 1fr;
			}

			.related-grid a {
				min-height: 0;
			}
		}

	@media (max-width: 640px) {
		.article-content :global(.airport-overview-table) {
			width: calc(100vw - 28px);
			margin-top: 26px;
			margin-bottom: 32px;
			border-radius: 11px;
		}

		.article-content :global(.airport-overview-table table) {
			display: table;
			min-width: 840px;
			margin: 0;
			border-radius: 0;
		}

		.article-content :global(table) {
			display: block;
			margin: 26px 0;
			border-radius: 11px;
		}

		.article-content :global(th),
		.article-content :global(td) {
			min-width: 122px;
			padding: 12px 13px;
			font-size: 13px;
		}

		.article-content :global(th:first-child) {
			border-top-left-radius: 10px;
		}

		.article-content :global(th:last-child) {
			border-top-right-radius: 10px;
		}
	}
</style>

<script>
	const lightbox = document.querySelector<HTMLDialogElement>('.image-lightbox');
	const lightboxImage = lightbox?.querySelector<HTMLImageElement>('.lightbox-image');
	const lightboxCaption = lightbox?.querySelector<HTMLElement>('.lightbox-caption');
	const closeButton = lightbox?.querySelector<HTMLButtonElement>('.lightbox-close');
	let activeThumbnail: HTMLImageElement | null = null;

	const closeLightbox = () => {
		lightbox?.close();
		activeThumbnail?.focus();
	};

	const openLightbox = (thumbnail: HTMLImageElement) => {
		if (!lightbox || !lightboxImage || !lightboxCaption) return;

		activeThumbnail = thumbnail;
		lightboxImage.src = thumbnail.currentSrc || thumbnail.src;
		lightboxImage.alt = thumbnail.alt;
		lightboxCaption.textContent = thumbnail.alt;
		lightbox.showModal();
	};

	document.querySelectorAll<HTMLImageElement>('.article-content img').forEach((thumbnail) => {
		thumbnail.tabIndex = 0;
		thumbnail.setAttribute('role', 'button');
		thumbnail.setAttribute('aria-label', `点击放大：${thumbnail.alt || '文章图片'}`);
		thumbnail.title = '点击查看大图';
		thumbnail.addEventListener('click', () => openLightbox(thumbnail));
		thumbnail.addEventListener('keydown', (event) => {
			if (event.key !== 'Enter' && event.key !== ' ') return;
			event.preventDefault();
			openLightbox(thumbnail);
		});
	});

	closeButton?.addEventListener('click', closeLightbox);
	lightbox?.addEventListener('click', (event) => {
		if (event.target === lightbox) closeLightbox();
	});
</script>
