---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	type?: 'website' | 'article';
	image?: string;
	publishedTime?: string;
	modifiedTime?: string;
	tags?: string[];
	jsonLd?: Record<string, unknown>[];
}

const {
	title = 'vpnsum.net｜VPN机场推荐、客户端教程与风险监测',
	description = '提供 VPN 机场推荐、Clash 节点与客户端教程、测试证据说明和机场风险监测。',
	noindex = false,
	type = 'website',
	image = '/site-og.jpg',
	publishedTime,
	modifiedTime,
	tags = [],
	jsonLd = [],
} = Astro.props;

const pageTitle = title.includes('vpnsum.net') ? title : `${title}｜vpnsum.net`;
const siteUrl = 'https://www.vpnsum.net';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
const siteJsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${siteUrl}/#website`,
			url: `${siteUrl}/`,
			name: 'vpnsum.net',
			description: '面向中文读者的 VPN 机场推荐、客户端教程、测试证据说明与风险监测。',
			inLanguage: 'zh-CN',
			publisher: { '@id': `${siteUrl}/#organization` },
		},
		{
			'@type': 'Organization',
			'@id': `${siteUrl}/#organization`,
			name: 'vpnsum.net 编辑团队',
			url: `${siteUrl}/`,
			logo: {
				'@type': 'ImageObject',
				url: `${siteUrl}/site-og.jpg`,
			},
		},
	],
};
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#07152b" />
		{noindex && <meta name="robots" content="noindex, follow" />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
			<link rel="canonical" href={canonicalUrl} />
			<meta property="og:type" content={type} />
			<meta property="og:locale" content="zh_CN" />
			<meta property="og:site_name" content="vpnsum.net" />
			<meta property="og:url" content={canonicalUrl} />
			<meta property="og:title" content={pageTitle} />
			<meta property="og:description" content={description} />
			<meta property="og:image" content={imageUrl} />
			<meta property="og:image:alt" content={`${title} 分享图片`} />
			{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
			{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
			{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
			<meta name="twitter:card" content="summary_large_image" />
			<meta name="twitter:title" content={pageTitle} />
			<meta name="twitter:description" content={description} />
			<meta name="twitter:image" content={imageUrl} />
			<script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
			{jsonLd.map((entry) => <script type="application/ld+json" set:html={JSON.stringify(entry)} />)}
			<title>{pageTitle}</title>
	</head>
	<body>
		<header class="site-header">
			<a class="site-brand" href="/" aria-label="vpnsum.net 首页">
				<span aria-hidden="true">VS</span>
				<span>vpnsum.net</span>
			</a>
			<nav class="site-nav" aria-label="主要导航">
				<a href="/posts/jichang-tuijian/">机场推荐</a>
				<a href="/guides/">使用指南</a>
				<a href="/evidence/">证据中心</a>
				<a class="nav-primary" href="/risk-monitor/">风险监测</a>
			</nav>
		</header>
		<slot />
		<footer class="site-footer">
			<div>
				<p class="footer-brand">vpnsum.net</p>
				<p>机场信息筛选、客户端教程、测试证据与风险监测。<br />重要选择请结合官方信息与自己的实际测试。</p>
			</div>
				<div class="footer-links">
					<a href="/about/">关于本站</a>
					<a href="/editorial-policy/">编辑政策</a>
					<a href="/corrections/">更正反馈</a>
					<a href="/posts/jichang-test-disclosure/">评测与披露</a>
					<a href="/evidence/">证据中心</a>
				</div>
		</footer>
	</body>
</html>
