	}

	.plan-calculator h2 {
		margin: 4px 0 10px !important;
		padding: 0 !important;
		border: 0 !important;
	}

	.plan-calculator p {
		margin: 0;
	}

	.calculator-kicker {
		color: #155eef !important;
		font-size: 12px !important;
		font-weight: 850;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.calculator-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 14px;
		margin-top: 24px;
	}

	.calculator-grid label {
		color: #344054;
		font-size: 13px;
		font-weight: 750;
	}

	.calculator-grid input {
		width: 100%;
		margin-top: 7px;
		padding: 11px 12px;
		border: 1px solid #c7d4e2;
		border-radius: 9px;
		background: #fff;
		color: #07152b;
		font: inherit;
		box-sizing: border-box;
	}

	.calculator-grid input:focus {
		border-color: #155eef;
		outline: 3px solid rgba(21, 94, 239, 0.14);
	}

	.calculator-results {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 10px;
		margin-top: 18px;
	}

	.calculator-results div {
		padding: 15px;
		border: 1px solid #dce4ee;
		border-radius: 11px;
		background: #fff;
	}

	.calculator-results span,
	.calculator-results strong {
		display: block;
	}

	.calculator-results span {
		color: #667085;
		font-size: 11px;
		font-weight: 700;
	}

	.calculator-results strong {
		margin-top: 5px;
		color: #102a4c;
