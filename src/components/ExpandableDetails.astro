---
interface Props {
	title: string;
	description?: string;
	open?: boolean;
}

const { title, description = '展开后查看完整资料', open = false } = Astro.props;
---

<details class="expandable-details" open={open}>
	<summary>
		<span>
			<strong>{title}</strong>
			<small>{description}</small>
		</span>
		<span class="details-action" aria-hidden="true">
			<span class="show-label">查看详情</span>
			<span class="hide-label">收起内容</span>
			<b>⌄</b>
		</span>
	</summary>
	<div class="details-content">
		<slot />
	</div>
</details>

<style>
	.expandable-details {
		margin: 34px 0;
		border: 1px solid #cfdbe8;
		border-radius: 16px;
		background: linear-gradient(180deg, #f8fbfe, #fff 82px);
		box-shadow: 0 12px 34px rgba(7, 21, 43, 0.07);
		overflow: hidden;
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		min-height: 82px;
		padding: 18px 20px;
		color: #07152b;
		cursor: pointer;
		list-style: none;
		user-select: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary:hover {
		background: rgba(21, 94, 239, 0.045);
	}

	summary:focus-visible {
		outline: 3px solid rgba(21, 94, 239, 0.38);
		outline-offset: -3px;
	}

	summary > span:first-child {
		display: grid;
		gap: 5px;
	}

	summary strong {
		font-size: 17px;
		line-height: 1.45;
	}

	summary small {
		color: #667085;
		font-size: 13px;
		line-height: 1.5;
	}

	.details-action {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 9px;
		padding: 8px 12px;
		border-radius: 999px;
		background: #155eef;
		color: white;
		font-size: 12px;
		font-weight: 800;
	}

	.details-action b {
		font-size: 16px;
		line-height: 1;
		transition: transform 0.2s ease;
	}

	.hide-label {
		display: none;
	}

	.expandable-details[open] .show-label {
		display: none;
	}

	.expandable-details[open] .hide-label {
		display: inline;
	}

	.expandable-details[open] .details-action b {
		transform: rotate(180deg);
	}

	.details-content {
		padding: 4px 20px 24px;
		border-top: 1px solid #dce4ee;
	}

	.details-content :global(h2) {
		margin-top: 1.6em !important;
		border-top: 0 !important;
	}

	.details-content :global(h2:first-child) {
		margin-top: 0.8em !important;
	}

	.details-content :global(table) {
		margin-top: 22px !important;
		margin-bottom: 22px !important;
	}

	@media (max-width: 640px) {
		summary {
			align-items: flex-start;
			gap: 14px;
			padding: 16px;
		}

		summary small {
			max-width: 210px;
		}

		.details-action {
			padding: 7px 9px;
		}

		.details-action .show-label,
		.details-action .hide-label {
			display: none;
		}

		.details-content {
			padding: 2px 14px 18px;
		}
	}
</style>
