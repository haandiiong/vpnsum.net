---
const features = [
	{
		number: '01',
		title: '内容优先',
		description: '默认输出静态 HTML，让页面更快、更轻，也更容易被搜索引擎发现。',
	},
	{
		number: '02',
		title: '按需交互',
		description: '只有真正需要互动的组件才会加载 JavaScript，不让访客为无用代码买单。',
	},
	{
		number: '03',
		title: '自由组合',
		description: '可以继续使用原生 Astro，也可以随时加入 React、Vue、Svelte 等组件。',
	},
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="一个快速、轻量、内容优先的 Astro 起始项目。" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>星迹 · Astro 起始项目</title>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="/" aria-label="星迹首页">
				<span class="brand-mark" aria-hidden="true">✦</span>
				<span>星迹</span>
			</a>
			<nav aria-label="主要导航">
				<a href="#features">特点</a>
				<a href="#start">开始</a>
				<a class="nav-cta" href="https://docs.astro.build/zh-cn/" target="_blank" rel="noreferrer">
					阅读文档 ↗
				</a>
			</nav>
		</header>

		<main>
			<section class="hero">
				<div class="eyebrow"><span></span> ASTRO STARTER / 2026</div>
				<h1>
					把想法变成<br />
					<span>快得惊人的网站。</span>
				</h1>
				<p class="hero-copy">
					这是一个干净、现代的 Astro 起点。没有臃肿依赖，只有清晰结构和恰到好处的设计。
				</p>
				<div class="hero-actions" id="start">
					<a class="button primary" href="#features">探索项目 <span aria-hidden="true">→</span></a>
					<a class="button secondary" href="https://astro.build/" target="_blank" rel="noreferrer">astro.build</a>
				</div>

				<div class="orbit" aria-hidden="true">
					<div class="orbit-ring ring-one"></div>
					<div class="orbit-ring ring-two"></div>
					<div class="planet">A</div>
					<div class="spark spark-one">✦</div>
					<div class="spark spark-two">·</div>
				</div>
			</section>

			<section class="features" id="features" aria-labelledby="features-title">
				<div class="section-heading">
					<p>为什么选择 Astro</p>
					<h2 id="features-title">更少负担，<br />更多创造。</h2>
				</div>
				<div class="feature-list">
					{features.map((feature) => (
						<article class="feature-card">
							<span class="feature-number">{feature.number}</span>
							<div>
								<h3>{feature.title}</h3>
								<p>{feature.description}</p>
							</div>
						</article>
					))}
				</div>
			</section>

			<section class="command" aria-label="开发提示">
				<div>
					<span class="status-dot"></span>
					<span>准备出发</span>
				</div>
				<code><span>$</span> npm run dev</code>
				<p>编辑 <strong>src/pages/index.astro</strong>，页面会自动更新。</p>
			</section>
		</main>

		<footer>
			<p>Built with <span aria-hidden="true">✦</span> Astro</p>
			<p>让互联网再快一点。</p>
		</footer>
	</body>
</html>

<style>
	@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Noto+Sans+SC:wght@400;500;600;700;800&display=swap');

	:root {
		--ink: #121212;
		--paper: #f3f0e8;
		--orange: #ff5d2a;
		--yellow: #ffd84d;
		--line: rgba(18, 18, 18, 0.16);
		font-family: 'Noto Sans SC', system-ui, sans-serif;
		color: var(--ink);
		background: var(--paper);
		font-synthesis: none;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-width: 320px;
		background:
			linear-gradient(rgba(18, 18, 18, 0.045) 1px, transparent 1px),
			linear-gradient(90deg, rgba(18, 18, 18, 0.045) 1px, transparent 1px),
			var(--paper);
		background-size: 48px 48px;
	}

	a {
		color: inherit;
	}

	.site-header {
		height: 84px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 clamp(24px, 5vw, 72px);
		border-bottom: 1px solid var(--line);
		background: rgba(243, 240, 232, 0.88);
		backdrop-filter: blur(12px);
		position: sticky;
		top: 0;
		z-index: 10;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 20px;
		font-weight: 800;
		text-decoration: none;
		letter-spacing: 0.08em;
	}

	.brand-mark {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		background: var(--orange);
		color: white;
	}

	nav {
		display: flex;
		align-items: center;
		gap: 32px;
		font-size: 14px;
		font-weight: 600;
	}

	nav a {
		text-decoration: none;
	}

	nav a:not(.nav-cta):hover {
		color: var(--orange);
	}

	.nav-cta {
		padding: 11px 17px;
		border: 1px solid var(--ink);
		border-radius: 999px;
		transition: 0.2s ease;
	}

	.nav-cta:hover {
		background: var(--ink);
		color: var(--paper);
	}

	main {
		overflow: hidden;
	}

	.hero {
		min-height: 710px;
		padding: 110px clamp(24px, 8vw, 120px) 92px;
		position: relative;
		border-bottom: 1px solid var(--line);
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 12px;
		font-family: 'DM Mono', monospace;
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.16em;
	}

	.eyebrow span {
		width: 34px;
		height: 2px;
		background: var(--orange);
	}

	h1 {
		max-width: 980px;
		margin: 28px 0 26px;
		font-size: clamp(56px, 8.5vw, 132px);
		line-height: 0.98;
		letter-spacing: -0.07em;
		font-weight: 800;
		position: relative;
		z-index: 2;
	}

	h1 span {
		color: var(--orange);
	}

	.hero-copy {
		max-width: 590px;
		margin: 0;
		font-size: clamp(17px, 2vw, 21px);
		line-height: 1.8;
		color: rgba(18, 18, 18, 0.7);
	}

	.hero-actions {
		display: flex;
		gap: 14px;
		margin-top: 36px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 26px;
		min-height: 54px;
		padding: 0 25px;
		border-radius: 4px;
		font-weight: 700;
		text-decoration: none;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.button:hover {
		transform: translateY(-3px);
	}

	.primary {
		background: var(--ink);
		color: white;
		box-shadow: 5px 5px 0 var(--orange);
	}

	.secondary {
		border: 1px solid var(--ink);
		background: rgba(243, 240, 232, 0.7);
	}

	.orbit {
		position: absolute;
		width: clamp(290px, 34vw, 500px);
		aspect-ratio: 1;
		right: -4%;
		top: 80px;
		opacity: 0.95;
	}

	.orbit-ring {
		position: absolute;
		inset: 5%;
		border: 1px solid rgba(18, 18, 18, 0.22);
		border-radius: 50%;
	}

	.ring-one {
		transform: rotate(-22deg) scaleY(0.34);
		border-width: 3px;
	}

	.ring-two {
		inset: 18%;
		border-style: dashed;
	}

	.planet {
		position: absolute;
		inset: 29%;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: var(--yellow);
		border: 2px solid var(--ink);
		box-shadow: 14px 14px 0 var(--orange);
		font: 800 clamp(80px, 10vw, 150px)/1 'Noto Sans SC', sans-serif;
		transform: rotate(7deg);
	}

	.spark {
		position: absolute;
		font-size: 46px;
	}

	.spark-one {
		left: 7%;
		top: 18%;
		color: var(--orange);
	}

	.spark-two {
		right: 8%;
		bottom: 20%;
		font-size: 90px;
	}

	.features {
		display: grid;
		grid-template-columns: 0.85fr 1.15fr;
		gap: clamp(40px, 8vw, 120px);
		padding: 110px clamp(24px, 8vw, 120px);
		background: var(--ink);
		color: var(--paper);
	}

	.section-heading > p {
		margin: 0 0 20px;
		color: var(--orange);
		font: 500 12px/1 'DM Mono', monospace;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h2 {
		margin: 0;
		font-size: clamp(44px, 6vw, 84px);
		line-height: 1.12;
		letter-spacing: -0.055em;
	}

	.feature-list {
		border-top: 1px solid rgba(243, 240, 232, 0.24);
	}

	.feature-card {
		display: grid;
		grid-template-columns: 54px 1fr;
		gap: 22px;
		padding: 32px 0;
		border-bottom: 1px solid rgba(243, 240, 232, 0.24);
	}

	.feature-number {
		color: var(--yellow);
		font: 500 12px/1 'DM Mono', monospace;
		padding-top: 8px;
	}

	.feature-card h3 {
		margin: 0 0 10px;
		font-size: 24px;
	}

	.feature-card p {
		max-width: 520px;
		margin: 0;
		color: rgba(243, 240, 232, 0.66);
		font-size: 16px;
		line-height: 1.8;
	}

	.command {
		margin: 90px auto;
		width: min(900px, calc(100% - 48px));
		padding: 28px 32px;
		border: 1px solid var(--ink);
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.38);
		box-shadow: 8px 8px 0 var(--yellow);
	}

	.command > div {
		display: flex;
		align-items: center;
		gap: 9px;
		margin-bottom: 24px;
		font-size: 13px;
		font-weight: 700;
	}

	.status-dot {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: #36a269;
		box-shadow: 0 0 0 4px rgba(54, 162, 105, 0.14);
	}

	.command code {
		display: block;
		font: 500 clamp(22px, 4vw, 38px)/1.3 'DM Mono', monospace;
	}

	.command code span {
		color: var(--orange);
	}

	.command p {
		margin: 20px 0 0;
		color: rgba(18, 18, 18, 0.62);
		font-size: 14px;
	}

	footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 30px clamp(24px, 5vw, 72px);
		border-top: 1px solid var(--line);
		font-size: 13px;
		font-weight: 600;
	}

	footer span {
		color: var(--orange);
	}

	@media (max-width: 900px) {
		nav > a:not(.nav-cta) {
			display: none;
		}

		.hero {
			min-height: auto;
			padding-top: 84px;
		}

		.hero-copy {
			max-width: 520px;
		}

		.orbit {
			position: relative;
			top: auto;
			right: auto;
			width: min(380px, 78vw);
			margin: 65px auto 0;
		}

		.features {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 560px) {
		.site-header {
			height: 72px;
		}

		.nav-cta {
			padding: 9px 13px;
		}

		.hero {
			padding-top: 62px;
		}

		h1 {
			font-size: clamp(46px, 16vw, 74px);
		}

		.hero-actions {
			flex-direction: column;
		}

		.button {
			width: 100%;
		}

		.features {
			padding-top: 76px;
			padding-bottom: 76px;
		}

		.feature-card {
			grid-template-columns: 38px 1fr;
		}

		.command {
			margin: 60px auto;
			padding: 24px 20px;
		}

		footer {
			align-items: flex-start;
			gap: 12px;
			flex-direction: column;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}

		.button {
			transition: none;
		}
	}
</style>
