---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allArticles = await getCollection('articles');

const toTimestamp = (value?: string | Date) => {
	if (!value) return 0;
	const date = new Date(String(value).replaceAll('/', '-'));
	return Number.isNaN(date.getTime()) ? 0 : date.getTime();
};

const articleEntries = allArticles
	.filter(({ data }) => !['/posts/', '/airports/', '/guides/', '/about/', '/disclaimer/'].includes(data.permalink))
	.sort((a, b) => toTimestamp(b.data.updateTime ?? b.data.createTime) - toTimestamp(a.data.updateTime ?? a.data.createTime));

const guideArticles = articleEntries.filter(({ data }) => data.permalink.startsWith('/guides/') && !data.noindex);
const latestArticles = guideArticles.slice(0, 6);
const categories = [
 { kicker: 'CHOOSE A CLIENT', title: '选择客户端', description: '区分Clash/Mihomo与sing-box配置，按设备选择对应的客户端。', href: '/guides/#先核对订阅格式', count: '设备与格式' },
 { kicker: 'IMPORT SUBSCRIPTION', title: '安装与导入订阅', description: '核对官方安装包、导入订阅，检查节点、代理模式与实际访问。', href: '/guides/clash-verge-rev/', count: '从这里开始' },
 { kicker: 'TROUBLESHOOTING', title: '连接故障排查', description: '从401、403、配置解析失败或节点超时开始，找到检查与恢复步骤。', href: '/guides/subscription-troubleshooting/#先按症状选择入口', count: '按错误提示' },
 { kicker: 'CHECK YOUR CONNECTION', title: '验证连接效果', description: '检查播放、连接与晚高峰表现，了解一次测速能说明什么。', href: '/posts/streaming-airport-test/', count: '实际场景检查' },
];

const categoryLabel = (permalink: string) => {
	if (permalink.startsWith('/airports/')) return '机场介绍';
	if (permalink.startsWith('/guides/')) return '客户端教程';
	if (permalink.startsWith('/risk-monitor/')) return '风险监测';
	if (permalink === '/evidence/') return '证据中心';
	return '实用指南';
};
---

<BaseLayout>
	<main>
		<section class="hero">
			<div class="hero-copy">
				<div class="eyebrow"><span></span> CLIENT GUIDES · CONNECTION · TROUBLESHOOTING</div>
				<h1>客户端教程，<br /><em>连接故障排查。</em></h1>
				<p>
					先核对订阅格式，再按设备选择客户端，完成配置导入与连接验证。
					遇到更新失败、节点超时或应用无法联网时，从错误提示开始，找到检查位置与恢复方法。
				</p>
				<div class="hero-actions">
					<a class="primary-button" href="/guides/">选择设备与客户端 <span>→</span></a>
					<a class="text-button" href="/guides/subscription-troubleshooting/">排查连接故障</a>
				</div>
			</div>
			<div class="signal-card" aria-label="内容更新状态">
				<div class="signal-top">
					<span class="live-dot"></span>
					<span>CONTENT STATUS</span>
					<span>2026</span>
				</div>
				<div class="signal-visual" aria-hidden="true">
					<div class="globe-grid"></div>
					<div class="pulse one"></div>
					<div class="pulse two"></div>
					<div class="pulse three"></div>
				</div>
				<div class="signal-stats">
					<div><strong>{guideArticles.length}</strong><span>篇使用指南</span></div>
					<div><strong>4</strong><span>使用入口</span></div>
					<div><strong>7</strong><span>排查步骤</span></div>
				</div>
			</div>
		</section>

		<section class="trust-strip" aria-label="内容原则">
			<span>按设备选择</span>
			<span>按步骤配置</span>
			<span>按症状排查</span>
			<span>连接结果验证</span>
		</section>

		<section class="category-section">
			<div class="section-heading">
				<div>
					<span class="section-number">01</span>
					<p>从你的问题开始</p>
				</div>
				<h2>四个入口，<br />找到需要的信息。</h2>
			</div>
			<div class="category-grid">
				{categories.map((category) => (
					<a class="category-card" href={category.href}>
						<div class="category-meta">
							<span>{category.kicker}</span>
							<span>{category.count}</span>
						</div>
						<h3>{category.title}</h3>
						<p>{category.description}</p>
						<span class="card-arrow">↗</span>
					</a>
				))}
			</div>
		</section>

		<section class="latest-section">
			<div class="latest-heading">
				<div>
					<span class="section-number light">02</span>
					<p>最近更新</p>
				</div>
				<h2>从安装配置，<br />到解决连接问题。</h2>
				<a href="/guides/">查看全部使用指南 →</a>
			</div>
			<div class="article-list">
				{latestArticles.map((article, index) => (
					<a class="article-row" href={article.data.permalink}>
						<span class="row-index">{String(index + 1).padStart(2, '0')}</span>
						<div>
							<span class="row-category">{categoryLabel(article.data.permalink)}</span>
							<h3>{article.data.title}</h3>
							{article.data.description && <p class="row-summary">{article.data.description}</p>}
						</div>
						<span class="row-arrow">→</span>
					</a>
				))}
			</div>
		</section>

		<section class="risk-callout">
			<div>
				<span class="risk-label">AIRPORT REFERENCE</span>
				<h2>需要核对机场资料？</h2>
				<p>查看服务的客户端兼容、订阅限制与资料来源；选购前再核对套餐和风险记录。</p>
			</div>
			<a href="/airports/">查看机场资料 <span>→</span></a>
		</section>
	</main>
</BaseLayout>

<style>
	.hero {
		min-height: 680px;
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(340px, 0.9fr);
		align-items: center;
		gap: clamp(54px, 8vw, 120px);
		padding: 92px clamp(22px, 7vw, 100px) 100px;
		background:
			radial-gradient(circle at 82% 14%, rgba(31, 109, 255, 0.2), transparent 26%),
			linear-gradient(125deg, #07152b 0%, #0a1d39 55%, #092843 100%);
		color: white;
		overflow: hidden;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 11px;
		color: #72e5d3;
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 0.18em;
	}

	.eyebrow span {
		width: 32px;
		height: 2px;
		background: #46d9c5;
	}

	h1 {
		max-width: 780px;
		margin: 25px 0 28px;
		font-size: clamp(48px, 6vw, 88px);
		line-height: 0.99;
		letter-spacing: -0.07em;
	}

	h1 em {
		font-style: normal;
		color: #46d9c5;
	}

	.hero-copy > p {
		max-width: 640px;
		margin: 0;
		color: rgba(255, 255, 255, 0.68);
		font-size: clamp(16px, 1.7vw, 19px);
		line-height: 1.85;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 28px;
		margin-top: 36px;
	}

	.primary-button {
		display: inline-flex;
		align-items: center;
		gap: 30px;
		padding: 15px 20px;
		border-radius: 10px;
		background: #46d9c5;
		color: #07152b;
		font-weight: 800;
		text-decoration: none;
		box-shadow: 0 12px 30px rgba(70, 217, 197, 0.14);
	}

	.text-button {
		color: rgba(255, 255, 255, 0.75);
		font-size: 14px;
		font-weight: 700;
		text-underline-offset: 5px;
	}

	.signal-card {
		width: min(100%, 470px);
		justify-self: end;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 20px;
		background: rgba(255, 255, 255, 0.055);
		box-shadow: 0 34px 90px rgba(0, 0, 0, 0.26);
		backdrop-filter: blur(12px);
		overflow: hidden;
	}

	.signal-top {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 10px;
		padding: 16px 18px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.11);
		color: rgba(255, 255, 255, 0.54);
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 0.14em;
	}

	.live-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #46d9c5;
		box-shadow: 0 0 0 5px rgba(70, 217, 197, 0.12);
	}

	.signal-visual {
		position: relative;
		height: 320px;
		background:
			radial-gradient(circle at center, rgba(70, 217, 197, 0.1), transparent 58%);
		overflow: hidden;
	}

	.globe-grid {
		position: absolute;
		width: 245px;
		height: 245px;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
		border: 1px solid rgba(70, 217, 197, 0.55);
		border-radius: 50%;
		background:
			linear-gradient(90deg, transparent 48%, rgba(70, 217, 197, 0.22) 49%, rgba(70, 217, 197, 0.22) 51%, transparent 52%),
			linear-gradient(transparent 48%, rgba(70, 217, 197, 0.22) 49%, rgba(70, 217, 197, 0.22) 51%, transparent 52%);
		box-shadow:
			inset 45px 0 0 -44px rgba(70, 217, 197, 0.4),
			inset -45px 0 0 -44px rgba(70, 217, 197, 0.4),
			0 0 60px rgba(70, 217, 197, 0.08);
	}

	.globe-grid::before,
	.globe-grid::after {
		content: '';
		position: absolute;
		inset: 18% -1px;
		border: 1px solid rgba(70, 217, 197, 0.28);
		border-radius: 50%;
	}

	.globe-grid::after {
		inset: -1px 26%;
	}

	.pulse {
		position: absolute;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #46d9c5;
		box-shadow: 0 0 0 6px rgba(70, 217, 197, 0.12), 0 0 22px #46d9c5;
	}

	.pulse.one { left: 26%; top: 35%; }
	.pulse.two { right: 25%; top: 47%; }
	.pulse.three { left: 47%; bottom: 24%; }

	.signal-stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border-top: 1px solid rgba(255, 255, 255, 0.11);
	}

	.signal-stats div {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 18px;
		border-right: 1px solid rgba(255, 255, 255, 0.11);
	}

	.signal-stats div:last-child { border: 0; }
	.signal-stats strong { font-size: 20px; }
	.signal-stats span { color: rgba(255, 255, 255, 0.48); font-size: 11px; }

	.trust-strip {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		background: #46d9c5;
		color: #07152b;
	}

	.trust-strip span {
		padding: 18px 20px;
		border-right: 1px solid rgba(7, 21, 43, 0.18);
		text-align: center;
		font-size: 12px;
		font-weight: 800;
	}

	.category-section {
		padding: 110px clamp(22px, 7vw, 100px);
		background: #f3f7fb;
	}

	.section-heading {
		display: grid;
		grid-template-columns: 0.7fr 1.3fr;
		gap: 40px;
		margin-bottom: 58px;
	}

	.section-number {
		display: inline-grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		background: #07152b;
		color: #46d9c5;
		font-size: 11px;
		font-weight: 800;
	}

	.section-heading p,
	.latest-heading p {
		margin: 14px 0 0;
		color: #667085;
		font-size: 13px;
		font-weight: 700;
	}

	h2 {
		margin: 0;
		font-size: clamp(42px, 5.5vw, 72px);
		line-height: 1.12;
		letter-spacing: -0.055em;
		color: #07152b;
	}

	.category-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		border-top: 1px solid #cdd8e5;
		border-left: 1px solid #cdd8e5;
	}

	.category-card {
		position: relative;
		min-height: 290px;
		padding: 30px;
		border-right: 1px solid #cdd8e5;
		border-bottom: 1px solid #cdd8e5;
		background: rgba(255, 255, 255, 0.42);
		text-decoration: none;
		transition: background 0.2s ease, transform 0.2s ease;
	}

	.category-card:hover {
		background: #fff;
		transform: translateY(-3px);
	}

	.category-meta {
		display: flex;
		justify-content: space-between;
		color: #667085;
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 0.12em;
	}

	.category-card h3 {
		margin: 80px 0 12px;
		font-size: clamp(27px, 3vw, 38px);
		letter-spacing: -0.035em;
		color: #07152b;
	}

	.category-card p {
		max-width: 440px;
		margin: 0;
		color: #667085;
		font-size: 14px;
		line-height: 1.75;
	}

	.card-arrow {
		position: absolute;
		right: 26px;
		bottom: 26px;
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		border-radius: 50%;
		background: #07152b;
		color: #fff;
	}

	.latest-section {
		display: grid;
		grid-template-columns: 0.8fr 1.2fr;
		gap: clamp(50px, 8vw, 120px);
		padding: 110px clamp(22px, 7vw, 100px);
		background: #07152b;
		color: white;
	}

	.section-number.light {
		background: #46d9c5;
		color: #07152b;
	}

	.latest-heading h2 {
		margin-top: 40px;
		color: white;
	}

	.latest-heading > a {
		display: inline-block;
		margin-top: 28px;
		color: #46d9c5;
		font-size: 13px;
		font-weight: 700;
	}

	.article-list {
		border-top: 1px solid rgba(255, 255, 255, 0.18);
	}

	.article-row {
		display: grid;
		grid-template-columns: 42px 1fr auto;
		align-items: center;
		gap: 18px;
		padding: 24px 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.18);
		text-decoration: none;
	}

	.row-index {
		color: rgba(255, 255, 255, 0.3);
		font-size: 11px;
	}

	.row-category {
		color: #46d9c5;
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 0.08em;
	}

	.article-row h3 {
		margin: 6px 0 0;
		font-size: clamp(17px, 2vw, 22px);
		line-height: 1.42;
		letter-spacing: -0.02em;
	}

	.row-summary {
		max-width: 760px;
		margin: 9px 0 0;
		color: rgba(255, 255, 255, 0.65);
		font-size: 13px;
		line-height: 1.7;
	}

	.row-arrow {
		color: #46d9c5;
		font-size: 20px;
		transition: transform 0.2s ease;
	}

	.article-row:hover .row-arrow { transform: translateX(5px); }

	.risk-callout {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 60px;
		padding: 80px clamp(22px, 7vw, 100px);
		background: #ffbd57;
		color: #07152b;
	}

	.risk-label {
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 0.15em;
	}

	.risk-callout h2 {
		margin: 14px 0 14px;
		font-size: clamp(38px, 5vw, 65px);
	}

	.risk-callout p {
		max-width: 670px;
		margin: 0;
		font-size: 15px;
		line-height: 1.75;
	}

	.risk-callout > a {
		flex: none;
		display: inline-flex;
		align-items: center;
		gap: 28px;
		padding: 15px 20px;
		border: 1px solid #07152b;
		border-radius: 10px;
		font-size: 14px;
		font-weight: 800;
		text-decoration: none;
	}

	@media (max-width: 980px) {
		.hero {
			grid-template-columns: 1fr;
		}

		.signal-card {
			justify-self: start;
		}

		.latest-section {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 700px) {
		.hero {
			padding-top: 68px;
		}

		h1 {
			font-size: clamp(44px, 12vw, 76px);
		}

		.hero-actions {
			align-items: flex-start;
			flex-direction: column;
		}

		.signal-visual {
			height: 280px;
		}

		.trust-strip {
			grid-template-columns: repeat(2, 1fr);
		}

		.trust-strip span {
			border-bottom: 1px solid rgba(7, 21, 43, 0.18);
		}

		.section-heading {
			grid-template-columns: 1fr;
		}

		.category-grid {
			grid-template-columns: 1fr;
		}

		.category-card {
			min-height: 250px;
		}

		.category-card h3 {
			margin-top: 54px;
		}

		.risk-callout {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
