---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
	const articles = await getCollection('articles');

	return articles.map((article) => {
		const articleTags = new Set(article.data.tags ?? []);
		const articleSection = article.data.permalink.split('/').filter(Boolean)[0] ?? '';
		const relatedArticles = articles
			.filter((candidate) => candidate.id !== article.id && !candidate.data.noindex)
			.map((candidate) => {
				const sharedTags = (candidate.data.tags ?? []).filter((tag) => articleTags.has(tag)).length;
				const candidateSection = candidate.data.permalink.split('/').filter(Boolean)[0] ?? '';
				const score = sharedTags * 3 + (candidateSection === articleSection ? 1 : 0);
				return {
					title: candidate.data.title,
					description: candidate.data.description,
					permalink: candidate.data.permalink,
					score,
				};
			})
			.filter((candidate) => candidate.score > 0)
			.sort((a, b) => b.score - a.score || a.title.localeCompare(b.title, 'zh-CN'))
			.slice(0, 3)
			.map(({ score: _score, ...candidate }) => candidate);

		return {
			params: {
				slug: article.data.permalink.replace(/^\/|\/$/g, ''),
			},
			props: { article, relatedArticles },
		};
	});
}

const { article, relatedArticles } = Astro.props;
const { Content, headings } = await render(article);
---

<ArticleLayout
	title={article.data.title}
	description={article.data.description}
	createTime={article.data.createTime}
	updateTime={article.data.updateTime}
	tags={article.data.tags}
	noindex={article.data.noindex}
	cover={article.data.cover}
	relatedArticles={relatedArticles}
	headings={headings}
	faq={article.data.faq}
	itemList={article.data.itemList}
>
	<Content />
</ArticleLayout>
